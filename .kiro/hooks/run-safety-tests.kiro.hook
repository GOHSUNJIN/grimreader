{
  "enabled": true,
  "name": "Run safety-check tests",
  "description": "When the shared rule checks or their tests change, run the test suite (including the property-based tests) and fix any failure before moving on.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["lib/**/*.js", "tests/**/*.js"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file in lib/ or tests/ was just edited. Run `npm test`. If any test fails, show the failing property and the counterexample fast-check found, explain which rule in applyChecks or redact it breaks, and fix the code (not the test) unless the test is wrong. Never weaken a safety invariant from requirements 5.2 to 5.7 of the read-your-own-letters spec."
  }
}
